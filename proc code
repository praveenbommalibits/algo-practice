package com.example.service;

import com.example.config.ProcedureConfig;
import com.example.config.ProcedureDefinition;
import jakarta.persistence.*;
import org.springframework.stereotype.Service;

import java.sql.Clob;
import java.sql.ResultSet;
import java.util.*;

@Service
public class StoredProcedureService {

    private final EntityManager entityManager;
    private final ProcedureConfig procedureConfig;

    public StoredProcedureService(EntityManager entityManager, ProcedureConfig procedureConfig) {
        this.entityManager = entityManager;
        this.procedureConfig = procedureConfig;
    }

    public Map<String, Object> callProcedure(String key, Map<String, Object> inputParams) {
        ProcedureDefinition def = procedureConfig.get(key);
        if (def == null) throw new IllegalArgumentException("Procedure not found: " + key);

        StoredProcedureQuery query = entityManager
                .createStoredProcedureQuery(def.getPackageName() + "." + def.getName());

        def.getInput().forEach((name, type) -> {
            query.registerStoredProcedureParameter(name, resolveClass(type), ParameterMode.IN);
            query.setParameter(name, inputParams.get(name));
        });

        def.getOutput().forEach((name, type) -> {
            query.registerStoredProcedureParameter(name, resolveClass(type), ParameterMode.OUT);
        });

        query.execute();

        Map<String, Object> result = new LinkedHashMap<>();
        for (Map.Entry<String, String> entry : def.getOutput().entrySet()) {
            Object value = query.getOutputParameterValue(entry.getKey());
            if (value instanceof Clob clob) {
                value = clobToString(clob);
            } else if (value instanceof ResultSet rs) {
                value = resultSetToList(rs);
            }
            result.put(entry.getKey(), value);
        }

        return result;
    }

    private Class<?> resolveClass(String type) {
        return switch (type.toLowerCase()) {
            case "string" -> String.class;
            case "integer" -> Integer.class;
            case "clob" -> Clob.class;
            case "cursor" -> ResultSet.class;
            default -> throw new IllegalArgumentException("Unsupported type: " + type);
        };
    }

    private String clobToString(Clob clob) {
        try (Scanner s = new Scanner(clob.getCharacterStream()).useDelimiter("\\A")) {
            return s.hasNext() ? s.next() : "";
        } catch (Exception e) {
            throw new RuntimeException("Failed to read CLOB", e);
        }
    }

    private List<Map<String, Object>> resultSetToList(ResultSet rs) {
        List<Map<String, Object>> rows = new ArrayList<>();
        try {
            var meta = rs.getMetaData();
            while (rs.next()) {
                Map<String, Object> row = new LinkedHashMap<>();
                for (int i = 1; i <= meta.getColumnCount(); i++) {
                    row.put(meta.getColumnName(i), rs.getObject(i));
                }
                rows.add(row);
            }
        } catch (Exception e) {
            throw new RuntimeException("Failed to read cursor", e);
        }
        return rows;
    }
}





// File: com.example.Application.java
package com.example;

import com.example.service.StoredProcedureService;
import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;

import java.util.Map;

@SpringBootApplication
public class Application {
    public static void main(String[] args) {
        SpringApplication.run(Application.class, args);
    }

    @Bean
    CommandLineRunner runner(StoredProcedureService procedureService) {
        return args -> {
            Map<String, Object> inputs = Map.of("customer_id", 1001);
            Map<String, Object> output = procedureService.callProcedure("getCustomerInfo", inputs);
            System.out.println("Stored procedure output: " + output);
        };
    }
}
