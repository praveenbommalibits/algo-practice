package com.example.service;

import com.example.config.ProcedureConfig;
import com.example.config.ProcedureDefinition;
import oracle.jdbc.OracleTypes;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.core.RowMapper;
import org.springframework.jdbc.core.SqlOutParameter;
import org.springframework.jdbc.core.SqlParameter;
import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
import org.springframework.jdbc.core.simple.SimpleJdbcCall;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;
import java.sql.*;
import java.util.*;

@Service
public class StoredProcedureService {

    private final JdbcTemplate jdbcTemplate;
    private final ProcedureConfig procedureConfig;
    private final Map<String, SimpleJdbcCall> procedureCallCache = new HashMap<>();

    public StoredProcedureService(JdbcTemplate jdbcTemplate, ProcedureConfig procedureConfig) {
        this.jdbcTemplate = jdbcTemplate;
        this.procedureConfig = procedureConfig;
    }

    public Map<String, Object> callProcedure(String key, Map<String, Object> inputParams) {
        ProcedureDefinition def = procedureConfig.get(key);
        if (def == null) throw new IllegalArgumentException("Procedure not found: " + key);

        SimpleJdbcCall jdbcCall = procedureCallCache.computeIfAbsent(key, k -> {
            SimpleJdbcCall call = new SimpleJdbcCall(jdbcTemplate)
                    .withCatalogName(def.getPackageName())
                    .withProcedureName(def.getName());

            List<SqlParameter> params = new ArrayList<>();
            if (def.getInput() != null) {
                def.getInput().forEach((name, type) -> {
                    params.add(new SqlParameter(name, mapSqlType(type)));
                });
            }

            if (def.getOutput() != null) {
                def.getOutput().forEach((name, type) -> {
                    if ("cursor".equalsIgnoreCase(type)) {
                        params.add(new SqlOutParameter(name, OracleTypes.CURSOR, defaultRowMapper()));
                    } else {
                        params.add(new SqlOutParameter(name, mapSqlType(type)));
                    }
                });
            }

            call.declareParameters(params.toArray(new SqlParameter[0]));
            return call;
        });

        MapSqlParameterSource inParams = new MapSqlParameterSource();

        if (def.getInput() != null) {
            def.getInput().forEach((name, type) -> {
                Object value = inputParams.getOrDefault(name, null);
                inParams.addValue(name, convertValue(value, type));
            });
        }

        Map<String, Object> out = jdbcCall.execute(inParams);
        Map<String, Object> result = new LinkedHashMap<>();

        if (def.getOutput() != null) {
            for (Map.Entry<String, String> entry : def.getOutput().entrySet()) {
                String keyName = entry.getKey();
                String type = entry.getValue();
                Object val = out.get(keyName);

                if (val instanceof Clob clob) {
                    val = clobToString(clob);
                }
                result.put(keyName, val);
            }
        }

        return wrapResponse(result);
    }

    private Object convertValue(Object val, String type) {
        if (val == null) {
            return switch (type.toLowerCase()) {
                case "integer" -> 0;
                case "long" -> 0L;
                case "double" -> 0.0;
                case "boolean" -> false;
                case "string" -> "";
                default -> null;
            };
        }

        return switch (type.toLowerCase()) {
            case "integer" -> Integer.valueOf(val.toString());
            case "long" -> Long.valueOf(val.toString());
            case "double" -> Double.valueOf(val.toString());
            case "boolean" -> Boolean.valueOf(val.toString());
            case "string" -> val.toString();
            default -> val;
        };
    }

    private int mapSqlType(String type) {
        return switch (type.toLowerCase()) {
            case "string" -> Types.VARCHAR;
            case "integer" -> Types.INTEGER;
            case "long" -> Types.BIGINT;
            case "double" -> Types.DOUBLE;
            case "boolean" -> Types.BOOLEAN;
            case "date" -> Types.DATE;
            case "clob" -> Types.CLOB;
            case "cursor" -> OracleTypes.CURSOR;
            default -> Types.VARCHAR;
        };
    }

    private RowMapper<Map<String, Object>> defaultRowMapper() {
        return (rs, rowNum) -> {
            Map<String, Object> row = new LinkedHashMap<>();
            ResultSetMetaData meta = rs.getMetaData();
            for (int i = 1; i <= meta.getColumnCount(); i++) {
                row.put(meta.getColumnLabel(i), rs.getObject(i));
            }
            return row;
        };
    }

    private String clobToString(Clob clob) {
        if (clob == null) return null;
        try (Scanner scanner = new Scanner(clob.getCharacterStream()).useDelimiter("\\A")) {
            return scanner.hasNext() ? scanner.next() : "";
        } catch (Exception e) {
            throw new RuntimeException("Failed to read Clob", e);
        }
    }

    private Map<String, Object> wrapResponse(Map<String, Object> result) {
        Map<String, Object> response = new LinkedHashMap<>();
        response.put("status", "success");

        if (result.containsKey("o_error_code")) {
            Integer errCode = (Integer) result.get("o_error_code");
            String errDesc = (String) result.getOrDefault("o_error_desc", "Unknown Error");

            response.put("errorCode", errCode);
            response.put("errorDesc", errDesc);

            if (errCode != null && errCode != 0) {
                response.put("status", "failure");
            }
        }

        response.put("data", result);
        return response;
    }
}
