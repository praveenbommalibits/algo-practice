public class ProcedureDefinition {
    private String name;
    private String packageName;
    private boolean transactional;
    private boolean suppressErrorCode;

    private Map<String, String> input;   // paramName -> type
    private Map<String, String> output;  // paramName -> type

    // Getters and setters
}



@Component
@ConfigurationProperties(prefix = "procedures")
@PropertySource(value = "classpath:stored-procedures.yml", factory = YamlPropertySourceFactory.class)
public class ProcedureConfig {

    private Map<String, ProcedureDefinition> procedures = new HashMap<>();

    public Map<String, ProcedureDefinition> getProcedures() {
        return procedures;
    }

    public void setProcedures(Map<String, ProcedureDefinition> procedures) {
        this.procedures = procedures;
    }

    public ProcedureDefinition get(String key) {
        return procedures.get(key);
    }
}



public class YamlPropertySourceFactory implements PropertySourceFactory {

    @Override
    public PropertySource<?> createPropertySource(String name, EncodedResource resource) throws IOException {
        YamlPropertiesFactoryBean factory = new YamlPropertiesFactoryBean();
        factory.setResources(resource.getResource());
        Properties props = factory.getObject();
        return new PropertiesPropertySource(resource.getResource().getFilename(), props);
    }
}




